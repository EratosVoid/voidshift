{
  "name": "@voidlabs.gg/voidshift",
  "version": "0.4.8",
  "description": "One CLI for the Void dev tools: keep your Mac awake, run agents in the background, shared skills and memory for Claude Code and Codex.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EratosVoid/voidshift.git",
    "directory": "packages/cli"
  },
  "homepage": "https://voidlabs.gg",
  "bugs": {
    "url": "https://github.com/EratosVoid/voidshift/issues"
  },
  "keywords": [
    "claude-code",
    "codex",
    "agents",
    "linear",
    "cli",
    "macos",
    "linux"
  ],
  "type": "module",
  "bin": {
    "voidshift": "dist/main.js",
    "vsf": "dist/main.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-force-exit --test-timeout=60000 test/*.test.ts",
    "dev": "node src/main.ts",
    "prepublishOnly": "rm -rf dist && tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "ink-testing-library": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
